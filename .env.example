# Copy this file to .env and fill it in. .env is ignored by git.

# The local model, through llama.cpp's llama-server. The eval starts and stops the server itself.
BANKRAG_LLAMA_SERVER=C:\path\to\llama-server.exe
BANKRAG_LOCAL_GGUF=C:\path\to\SmolLM3-Q4_K_M.gguf

# Or an OpenAI-compatible server that is already running, such as Ollama or LM Studio
# (not tested; only llama-server was):
# BANKRAG_LOCAL_URL=http://localhost:11434
# BANKRAG_LOCAL_MODEL=qwen3:4b

# Claude Haiku 5.5 through the Anthropic API, for `--provider claude-haiku`:
# ANTHROPIC_API_KEY=
# BANKRAG_CLAUDE_EFFORT=low
